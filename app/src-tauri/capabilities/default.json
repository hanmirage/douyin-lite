{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口加载 douyin.com。远程页只能调用本应用的下载命令，且下载命令本身有域名白名单。",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["https://www.douyin.com", "https://douyin.com"]
  },
  "permissions": ["core:default", "allow-dy-ingest", "allow-dy-download", "allow-dy-set-titlebar"]
}
